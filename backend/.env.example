# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wayn

# Long random strings, different from each other
JWT_SECRET=
REFRESH_TOKEN_SECRET=

# Where the web app runs (CORS and links in emails); comma-separate several origins
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Password-reset emails (https://resend.com); without a key, reset emails fail to send
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev

# Optional: your own Nominatim / OSRM servers (defaults are the public ones)
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# OSRM_URL=https://router.project-osrm.org
# GEOCODER_USER_AGENT=Wayn/1.0 (you@example.com)
